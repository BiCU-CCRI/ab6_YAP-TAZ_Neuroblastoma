# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Not sure if this is necessary
# Local and cloud environments are similar. Would be nice to have a single setting for both
# Manually select your environment: HPC_SLURM, DEVCONTAINER
# This determines which data paths and setup scripts to use
ENVIRONMENT=HPC_SLURM
_PROJECT_ROOT_="/nobackup/lab_ccri_bicu/internal/abykov/projects/ab6_soeren_neuroblastoma/adaptation_for_cemm/ab6_YAP-TAZ_Neuroblastoma"

# ==============================================================================
# COMMON ENVIRONMENT PATHS
# ==============================================================================
RAW_DATA_LOCATION="${_PROJECT_ROOT_}/data_raw"
PROCESSED_DATA_PATH="${_PROJECT_ROOT_}/data_processed"

# ==============================================================================
# CELLRANGER CONFIGURATION
# ==============================================================================
CELL_RANGER_LOCATION="${_PROJECT_ROOT_}/envs/tools/cellranger/cellranger-9.0.1"

# ==============================================================================
# RAW DATA PATHS
# ==============================================================================
# Location of the raw data FASTQ files
RAW_DATA_FASTQ_PATH="/nobackup/lab_ccri_bicu/internal/abykov/projects/data_vault/20251013_ERDERA_scRNAseq/raw_data/BSF_1798_HCW7MDRX7_req_119/"

# ==============================================================================
# REFERENCE GENOME PATHS
# ==============================================================================
# hg38 human reference genome
HG38_FASTA_REFERENCE_PATH="/nobackup/lab_ccri_bicu/internal/shared/references/human/GRCh38/Ensembl_v115/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz"
HG38_GTF_REFERENCE_PATH="/nobackup/lab_ccri_bicu/internal/shared/references/human/GRCh38/Ensembl_v115/Homo_sapiens.GRCh38.115.chr.gtf.gz"
# EBV reference genome
EBV_FASTA_REFERENCE_PATH="/nobackup/lab_ccri_bicu/internal/shared/references/EBV/ASM240226v1/GCF_002402265.1_ASM240226v1_genomic.fna.gz"
EBV_GTF_REFERENCE_PATH="/nobackup/lab_ccri_bicu/internal/shared/references/EBV/ASM240226v1/GCF_002402265.1_ASM240226v1_genomic.gtf.gz"

# ==============================================================================
# NEXTFLOW CONFIGURATION
# ==============================================================================
# Singularity/Apptainer cache directory for containers
NXF_SINGULARITY_CACHEDIR="/nobackup/lab_ccri_bicu/public/apptainer_images/"

# Nextflow work directory (optional - for temporary files)
# NXF_WORK="/scratch/$USER/nextflow_work"

# Default Nextflow profile to use
NXF_PROFILE="singularity"

# SLURM-specific Nextflow configuration file
SLURM_NEXTFLOW_CONFIG="/nobackup/lab_ccri_bicu/public/pipelines/slurm_large.config"

# ==============================================================================
# RSTUDIO CONFIGURATION
# ==============================================================================
#R_APPTAINER_IMG="/nobackup/lab_ccri_bicu/internal/abykov/resources/sifs/corebioinf_dockrstudio_tidyverse_4.5.1-claude-celltypist.sif"
R_APPTAINER_IMG="/research/lab_ccri_bicu/public/apptainer_images/Rstudio-4.5.1-claude-celltypist.sif"